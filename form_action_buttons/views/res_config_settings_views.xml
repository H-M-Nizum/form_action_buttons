<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_form_action_buttons" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.form.action.buttons</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Form Buttons" name="form_action_buttons" groups="base.group_system">
                    <block title="Save and Discard Buttons" id="form_action_buttons_block">
                        <setting string="Save button" help="Colours of the Save button shown in the top-left corner of every form.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="fab_save_bg" class="col-lg-4 o_light_label"/>
                                    <field name="fab_save_bg" widget="color" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="fab_save_text" class="col-lg-4 o_light_label"/>
                                    <field name="fab_save_text" widget="color" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Discard button" help="Colours of the Discard button shown next to the Save button.">
                            <div class="content-group">
                                <div class="row mt8">
                                    <label for="fab_discard_bg" class="col-lg-4 o_light_label"/>
                                    <field name="fab_discard_bg" widget="color" class="col-lg-2"/>
                                </div>
                                <div class="row mt8">
                                    <label for="fab_discard_text" class="col-lg-4 o_light_label"/>
                                    <field name="fab_discard_text" widget="color" class="col-lg-2"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
